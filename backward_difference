def f(x):
    return x**3
def backward_difference(x, h):
    return (f(x) - f(x - h)) / h
x = 2
h = 0.01
numerical=backward_difference(x, h)
exact = 3 * x**2
error = abs(numerical - exact)
print(f"Numerical derivative: {numerical:.8f}")
print(f"Exact derivative: {exact:.8f}")
print(f"Absolute error: {error:.8f}")